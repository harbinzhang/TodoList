# Environment setup:
#   .env.development  — loaded by `vite` (dev server), emulators ON
#   .env.production   — loaded by `vite build`, emulators OFF
#   .env              — local overrides (gitignored)
#
# Firebase Configuration (client-side keys)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Environment flags
VITE_DEPLOY_TARGET=local|prod
VITE_USE_EMULATORS=true|false

# Emulator ports (must match firebase.json)
VITE_EMULATOR_AUTH_HOST=localhost:9299
VITE_EMULATOR_FIRESTORE_HOST=localhost
VITE_EMULATOR_FIRESTORE_PORT=8280
